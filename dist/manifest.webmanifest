{
  "id": "com.globalstar.app",
  "name": "Global Star",
  "short_name": "Global Star",
  "description": "Application de gestion Global Star Distribution",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "dir": "ltr",
  "lang": "fr",
  "background_color": "#FFFFFF",
  "theme_color": "#C98B3B",
  "icons": [
    {
      "src": "/icons/icon-48.webp",
